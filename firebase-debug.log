[debug] [2026-08-27T12:11:15.565Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/wisemedbilling-c0d0a/rulesets {"name":"projects/wisemedbilling-c0d0a/rulesets/4d7daded-92b7-491c-b087-6afdcad2ce1c","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    function isActiveCrmUser() {\n      return request.auth != null &&\n        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&\n        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == \"active\" &&\n        (!(\"mustChangePassword\" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||\n          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mustChangePassword == false);\n    }\n\n    function currentCrmUser() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n\n    function currentRole() {\n      return get(/databases/$(database)/documents/roles/$(currentCrmUser().roleId)).data;\n    }\n\n    function hasPermission(permission) {\n      return isActiveCrmUser() && currentRole().status == \"active\" &&\n        permission in currentRole().permissions;\n    }\n\n    function isAdmin() {\n      return isActiveCrmUser() && currentCrmUser().roleId == \"admin\";\n    }\n\n    function isManager() {\n      return isActiveCrmUser() && currentCrmUser().roleId == \"sales_manager\";\n    }\n\n    function isSalesperson() {\n      return isActiveCrmUser() && currentCrmUser().roleId == \"sales\";\n    }\n\n    function isOwnedByCurrentUser() {\n      return \"ownerId\" in resource.data &&\n        resource.data.ownerId == request.auth.uid;\n    }\n\n    function ownerIsActiveTeamMember(ownerId) {\n      return ownerId is string &&\n        exists(/databases/$(database)/documents/users/$(ownerId)) &&\n        get(/databases/$(database)/documents/users/$(ownerId)).data.status == \"active\" &&\n        (\n          (\n            \"teamId\" in currentCrmUser() &&\n            currentCrmUser().teamId is string &&\n            currentCrmUser().teamId != \"\" &&\n            \"teamId\" in get(/databases/$(database)/documents/users/$(ownerId)).data &&\n            get(/databases/$(database)/documents/users/$(ownerId)).data.teamId == currentCrmUser().teamId\n          ) ||\n          (\n            (!(\"teamId\" in currentCrmUser()) ||\n              currentCrmUser().teamId == null ||\n              currentCrmUser().teamId == \"\") &&\n            \"managerId\" in get(/databases/$(database)/documents/users/$(ownerId)).data &&\n            get(/databases/$(database)/documents/users/$(ownerId)).data.managerId == request.auth.uid\n          )\n        );\n    }\n\n    function isManagerTeamLead() {\n      return isOwnedByCurrentUser() ||\n        (\"ownerId\" in resource.data && ownerIsActiveTeamMember(resource.data.ownerId));\n    }\n\n    match /crm_leads/{leadId} {\n      allow read: if\n        (isAdmin() && hasPermission(\"leads.read.all\")) ||\n        (isManager() && hasPermission(\"leads.read.all\") && isManagerTeamLead()) ||\n        (isSalesperson() &&\n          (hasPermission(\"leads.read.owned\") || hasPermission(\"leads.read.all\")) &&\n          isOwnedByCurrentUser()) ||\n        (!isAdmin() && !isManager() && !isSalesperson() &&\n          (hasPermission(\"leads.read.all\") ||\n            (hasPermission(\"leads.read.owned\") && isOwnedByCurrentUser())));\n      allow write: if false;\n    }\n\n    match /consultations/{consultationId} {\n      allow read: if false;\n      allow write: if false;\n    }\n\n    match /users/{userId} {\n      allow read: if isActiveCrmUser() && request.auth.uid == userId;\n      allow write: if false;\n    }\n\n    match /roles/{roleId} {\n      allow read: if isActiveCrmUser() && (\n        roleId == currentCrmUser().roleId ||\n        hasPermission(\"roles.read\") || hasPermission(\"roles.manage\")\n      );\n      allow write: if false;\n    }\n\n    match /employee_activities/{activityId} {\n      allow read: if isActiveCrmUser() && request.auth.uid == resource.data.actorId;\n      allow write: if false;\n    }\n\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-08-27T12:11:16.033087Z","metadata":{"services":["cloud.firestore"]}}
