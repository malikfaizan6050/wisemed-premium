rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveCrmUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active";
    }

    function currentCrmUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentRole() {
      return get(/databases/$(database)/documents/roles/$(currentCrmUser().roleId)).data;
    }

    function hasPermission(permission) {
      return isActiveCrmUser() && currentRole().status == "active" &&
        permission in currentRole().permissions;
    }

    match /crm_leads/{leadId} {
      allow read: if hasPermission("leads.read.all") ||
        (hasPermission("leads.read.owned") && resource.data.ownerId == request.auth.uid);
      allow write: if false;
    }

    match /consultations/{consultationId} {
      allow read: if false;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /roles/{roleId} {
      allow read: if isActiveCrmUser() && (
        roleId == currentCrmUser().roleId ||
        hasPermission("roles.read") || hasPermission("roles.manage")
      );
      allow write: if false;
    }

    match /employee_activities/{activityId} {
      allow read: if isActiveCrmUser() && request.auth.uid == resource.data.actorId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
