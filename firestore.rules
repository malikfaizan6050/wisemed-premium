rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveCrmUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active" &&
        (!("mustChangePassword" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.mustChangePassword == false);
    }

    function currentCrmUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentRole() {
      return get(/databases/$(database)/documents/roles/$(currentCrmUser().roleId)).data;
    }

    function hasPermission(permission) {
      return isActiveCrmUser() && currentRole().status == "active" &&
        permission in currentRole().permissions;
    }

    function isAdmin() {
      return isActiveCrmUser() && currentCrmUser().roleId == "admin";
    }

    function isManager() {
      return isActiveCrmUser() && currentCrmUser().roleId == "sales_manager";
    }

    function isSalesperson() {
      return isActiveCrmUser() && currentCrmUser().roleId == "sales";
    }

    function isOwnedByCurrentUser() {
      return "ownerId" in resource.data &&
        resource.data.ownerId == request.auth.uid;
    }

    function ownerIsActiveTeamMember(ownerId) {
      return ownerId is string &&
        exists(/databases/$(database)/documents/users/$(ownerId)) &&
        get(/databases/$(database)/documents/users/$(ownerId)).data.status == "active" &&
        (
          (
            "teamId" in currentCrmUser() &&
            currentCrmUser().teamId is string &&
            currentCrmUser().teamId != "" &&
            "teamId" in get(/databases/$(database)/documents/users/$(ownerId)).data &&
            get(/databases/$(database)/documents/users/$(ownerId)).data.teamId == currentCrmUser().teamId
          ) ||
          (
            (!("teamId" in currentCrmUser()) ||
              currentCrmUser().teamId == null ||
              currentCrmUser().teamId == "") &&
            "managerId" in get(/databases/$(database)/documents/users/$(ownerId)).data &&
            get(/databases/$(database)/documents/users/$(ownerId)).data.managerId == request.auth.uid
          )
        );
    }

    function isManagerTeamLead() {
      return isOwnedByCurrentUser() ||
        ("ownerId" in resource.data && ownerIsActiveTeamMember(resource.data.ownerId));
    }

    match /crm_leads/{leadId} {
      allow read: if
        (isAdmin() && hasPermission("leads.read.all")) ||
        (isManager() && hasPermission("leads.read.all") && isManagerTeamLead()) ||
        (isSalesperson() &&
          (hasPermission("leads.read.owned") || hasPermission("leads.read.all")) &&
          isOwnedByCurrentUser()) ||
        (!isAdmin() && !isManager() && !isSalesperson() &&
          (hasPermission("leads.read.all") ||
            (hasPermission("leads.read.owned") && isOwnedByCurrentUser())));
      allow write: if false;
    }

    match /consultations/{consultationId} {
      allow read: if false;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isActiveCrmUser() && request.auth.uid == userId;
      allow write: if false;
    }

    match /roles/{roleId} {
      allow read: if isActiveCrmUser() && (
        roleId == currentCrmUser().roleId ||
        hasPermission("roles.read") || hasPermission("roles.manage")
      );
      allow write: if false;
    }

    match /employee_activities/{activityId} {
      allow read: if isActiveCrmUser() && request.auth.uid == resource.data.actorId;
      allow write: if false;
    }

    // Import history is server-managed through the admin-only import API.
    match /import_history/{importId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
