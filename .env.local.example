# Copy to .env.local and fill in. Values are never committed.
# Every variable set here must ALSO be set in the deployment platform:
# NEXT_PUBLIC_* values are inlined at build time, and a missing one yields
# undefined rather than an error, so the feature silently stops working.

# --- Firebase Admin (server). Same project as the client config below. ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Full service-account PEM. Real newlines or literal \n both work.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Firebase (browser) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- URLs. Define each exactly once; a duplicate key silently wins. ---
# Canonical origin for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=
# Origin used for links inside CRM emails.
NEXT_PUBLIC_APP_URL=

# --- Consultation form spam protection ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Email. If unset, sending is skipped and the lead is still saved. ---
RESEND_API_KEY=
CRM_EMAIL_FROM=

# --- Scheduled jobs. Required: without it the nightly overdue-lead ---
# --- sweep in vercel.json cannot authenticate and never runs.       ---
CRON_SECRET=

# --- Server-to-server lead ingestion. Never a browser credential. ---
WISEMED_CRM_API_KEY=

# --- WhatsApp Business webhook ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Click-to-chat number. Falls back to the number in src/lib/contact.ts.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- AI assistant knowledge search ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GEMINI_API_KEY=

# --- Optional. Temporary-password lifetime; default 24, capped at 168. ---
CRM_TEMPORARY_PASSWORD_TTL_HOURS=
